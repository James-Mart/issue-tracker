plans/

# Tracker runtime store (not app/src/features/issues/)
/issues/

# Conversation runtime store (peer of issues/)
/conversations/

# Review-owned runtimes (peer of issues/). Conversation agent stacks stay under conversations/.
/review-runtimes/

# API process logs and crash reports (peer of issues/)
/logs/

# Durable SDK model catalog (peer of issues/ / conversations/)
/model-slug-catalog.json

# Delegation index runtime store (peer of conversations/)
/delegation-index.json

# Playwright MCP console logs and page snapshots
app/.playwright-mcp/

# Ad-hoc agent screenshots (committed e2e snapshots live in subfolders)
/app/*.png

# Vitest/Vite local cache (not source)
.vite/

# Logs
*.log

# Local env
.env
.env.local
.env.*.local

# Storybook static build output
app/storybook-static/
